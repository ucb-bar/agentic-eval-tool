{
  "title": "aet — Eval Overview",
  "uid": "aet-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Validator Duration (p50/p95) by Validator",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(aet_aet_validation_duration_seconds_bucket[5m])) by (aet_validator_name)",
          "legendFormat": "p50 {{aet_validator_name}}"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(aet_aet_validation_duration_seconds_bucket[5m])) by (aet_validator_name)",
          "legendFormat": "p95 {{aet_validator_name}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 2,
      "title": "Token Usage (input + output) over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(aet_gen_ai_client_token_usage_bucket[5m])) by (gen_ai_token_type)",
          "legendFormat": "{{gen_ai_token_type}} tokens/s"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 3,
      "title": "LLM Operation Duration (p50/p95)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(aet_gen_ai_client_operation_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(aet_gen_ai_client_operation_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 4,
      "title": "Total Token Usage",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(aet_gen_ai_client_token_usage_bucket) by (gen_ai_token_type)",
          "legendFormat": "{{gen_ai_token_type}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ],
  "time": {"from": "now-1h", "to": "now"}
}
